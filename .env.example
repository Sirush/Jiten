# Database credentials
DB_PASSWORD=password
DB_USER=postgres
DB_NAME=jiten
DB_HOST=postgres

# API configuration
STATIC_FILES_PATH=/app/uploads
DICTIONARY_PATH=/path/to/system_full.dic
FASTTEXT_MODEL_PATH=/app/uploads/models/cc.ja.300.bin
JIMAKU_API_KEY=
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
DOTNET_ENVIRONMENT=Development
STORE_RAW_TEXT=false
DISCORD_WEBHOOK=
VOICEVOX_URL=http://voicevox:50021

# Shared secret exempting first-party SSR from the per-IP rate limit.
# Must match NUXT_SSR_BYPASS_KEY on the web app. Empty disables the bypass.
SSR_BYPASS_KEY=

# BunnyCDN - public zone (deck covers, frequency list downloads)
USE_BUNNYCDN=false
BUNNYCDN_SECRET=
BUNNYCDN_STORAGE_ZONE=
CDN_BASE_URL=
BUNNYCDN_API_KEY=

# BunnyCDN - private zone for user-uploaded card media.
# Requires a second storage zone plus a pull zone over it with Token Authentication enabled.
# Leaving these blank falls back to the public zone with unsigned URLs.
BUNNYCDN_USER_STORAGE_ZONE=
BUNNYCDN_USER_SECRET=
CDN_SECURE_PULL_ZONE_URL=
CDN_TOKEN_AUTH_KEY=

# Stripe (Jiten+ billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_LIFETIME_PRICE_CENTS=15000
# Lifetime purchases are rejected after this instant. Default is in the past: set it to open the window.
STRIPE_LIFETIME_WINDOW_END=2000-01-01T00:00:00Z

# Jiten+ card media storage allowance, in bytes (300 MB trial / 10 GB paid)
JITENPLUS_TRIAL_STORAGE_BYTES=314572800
JITENPLUS_FULL_STORAGE_BYTES=10737418240

# Web configuration
API_BASE_URL=http://localhost:8080/api
UMAMI_ANALYTICS_WEBSITE_ID=
UMAMI_ANALYTICS_HOST_URL=http://localhost:3005

# Umami analytics service configuration
UMAMI_APP_SECRET=replace-me-with-a-random-string
UMAMI_HASH_SALT=some-random-string
UMAMI_TRACKER_SCRIPT_NAME=umm.js

# Redis configuration
REDIS_PORT=6379
REDIS_MAX_MEMORY=2

# JWT configuration
JWT_SECRET=VERY_STRONG_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=https://api.jiten.moe
JWT_AUDIENCE=https://jiten.moe
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# Google oAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_RECAPTCHA_SECRET=
GOOGLE_RECAPTCHA_V2_SITE_KEY=

# SMTP configuration (variable names must match docker-compose.yml)
SES_SMTP_HOST=smtp.eu.mailgun.org
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_FROM=noreply@example.com

# Observability
LOG_CONSOLE=false
LOG_OTLP=true
LOG_OTLP_ENDPOINT=
LOG_OTLP_HEADER=authorization=TOKEN

# RunPod difficulty model endpoints
RUNPOD_API_KEY=
RUNPOD_NOVELS_ENDPOINT_ID=
RUNPOD_SHOWS_ENDPOINT_ID=

# IndexNow
INDEXNOW_KEY=
INDEXNOW_SITE_URL=https://jiten.moe
