    "@nuxt/eslint": "1.15.2",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/sql.js": "1.4.11",
    "cross-env": "7.0.3",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "p": "0.2.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
