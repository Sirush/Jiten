    "@nuxt/icon": "1.15.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxtjs/mdc": "^0.22.0",
    "@nuxtjs/seo": "3.4.0",
    "@pinia/nuxt": "0.11.3",
    "@primeuix/themes": "1.2.5",
    "@primevue/forms": "4.5.5",
    "@radix-icons/vue": "1.0.0",
    "@tailwindcss/vite": "4.2.4",
    "@unhead/vue": "2.1.13",
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "hatsuon": "2.0.0",
    "jszip": "3.10.1",
    "nuxt": "4.4.2",
    "nuxt-umami": "3.2.1",
    "nuxt-vue3-google-signin": "0.0.13",
    "patch-package": "8.0.1",
    "perfect-debounce": "1.0.0",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "sql.js": "1.14.1",
    "tailwindcss": "4.2.4",
    "tailwindcss-primeui": "0.5.1",
    "vue": "3.5.33",
    "vue-chartjs": "5.3.3",
    "vue-recaptcha": "3.0.0-alpha.6",
    "vue-router": "5.0.6",
    "wanakana": "^5.3.1",
    "yanki-connect": "3.2.4"
